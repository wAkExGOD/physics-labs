        N:=StrToInt(edNumber.Text);
        If tbSpeed.Position>0 then
          begin
            ExperimentBtn.Caption:='&Стоп';
            timerExperiment.Interval:=trunc(1+(20*(tbSpeed.Position-1)));    //увеличиваем скорость эксперимента
            K:=0;
